[Unit]
Description=a8se-push: notificações de notícias do a8se.com (uma execução)
Documentation=file:///opt/a8se-push/src/docs/SPEC.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=a8se-push
Group=a8se-push
Environment=A8SE_PUSH_CONFIG=/etc/a8se-push/config.toml
EnvironmentFile=/etc/a8se-push/a8se-push.env
# O lock contra execuções sobrepostas é feito pelo próprio worker em
# /var/lib/a8se-push/a8se-push.lock (vale também para `a8se-push send` via SSH).
ExecStart=/opt/a8se-push/venv/bin/a8se-push run
TimeoutStartSec=120

# /var/lib/a8se-push, criado pelo systemd e gravável só por este serviço
StateDirectory=a8se-push
StateDirectoryMode=0750

# Endurecimento
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
